# Spike AD-012: assinante ROS 2 como serviço vendor, no domínio SELinux do VHAL
# (o binário é rotulado hal_vehicle_default_exec por install-vendor.sh).
# Iniciar: adb shell start vipee_twist_listener. Saída no logcat (tag vipee_twist).
service vipee_twist_listener /vendor/bin/vipee_twist_listener
    class hal
    user vehicle_network
    group system inet
    disabled
    setenv RMW_IMPLEMENTATION rmw_cyclonedds_cpp
    setenv ROS_DOMAIN_ID 25
    setenv CYCLONEDDS_URI file:///vendor/etc/vipee/cyclonedds_device.xml
