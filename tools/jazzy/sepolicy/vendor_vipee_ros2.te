# Processo ROS 2 da ponte (AD-012): assina os tópicos do simulador via
# CycloneDDS em TCP. Regras levantadas em permissivo (STATE, 2026-10-28).
type vendor_vipee_ros2, domain;
type vendor_vipee_ros2_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_vipee_ros2)

# Sockets TCP/UDP do DDS (dial-out para o host).
net_domain(vendor_vipee_ros2)

# Cyclone lista as interfaces (getifaddrs) via netlink. Sem nlmsg_readpriv,
# que expõe MAC e dados privilegiados.
allow vendor_vipee_ros2 self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_read };

# Cyclone lê /proc/net/wireless ao listar interfaces; negar não muda nada.
dontaudit vendor_vipee_ros2 proc_net:file read;

# Socket da ponte até o VHAL (AD-013): o init cria /dev/socket/vipee_vhal no
# .rc do VHAL (hal_vehicle_default); só o processo ROS conecta. Listen/accept
# do lado do VHAL já vêm de domain.te (self:unix_stream_socket).
type vipee_vhal_socket, file_type;
unix_socket_connect(vendor_vipee_ros2, vipee_vhal, hal_vehicle_default)

# Câmeras (AD-015): escreve YUYV nos /dev/video40..43 do v4l2loopback, que a
# HAL evs-v4l2 (hal_evs_default) lê. ioctl inclui VIDIOC_S_FMT.
allow vendor_vipee_ros2 video_device:chr_file rw_file_perms;

# Endereço do host DDS (persist.vendor.vipee.host, RPI-05), lido na partida.
get_prop(vendor_vipee_ros2, vendor_vipee_prop)
